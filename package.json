  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "dev:staging": "vite --mode staging",
    "build:staging": "vite build --mode staging",
    "native:sync": "vite build --mode staging && cap sync",
