    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource/bodoni-moda": "^5.3.0",
    "@fontsource/cormorant": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@openai/agents-realtime": "^0.18.0",
    "@supabase/auth-js": "^2.117.2",
